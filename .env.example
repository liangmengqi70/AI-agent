# 复制为 .env.local 后填写。.env.local 只保存在你的电脑上，不要发给别人。
# 部署到 Railway 时，在服务的 Variables 中填写同样的变量（见 部署说明.md）。

# 数据库：与 ResumeIQ 共用同一个 MySQL，库名为 jobagent
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=jobagent
MYSQL_USER=root
MYSQL_PASSWORD=

# 大模型（DeepSeek）。模型名留空时使用默认值：快速 deepseek-flash、推理 deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=
DEEPSEEK_REASON_MODEL=
DEEPSEEK_OCR_MODEL=

# 限额：每个访客每天上传简历次数
UPLOAD_DAILY_LIMIT=3
# 大模型调用上限（最近 24 小时）。留空：本地不限制，生产默认全站 3500 次、每个访客 200 次；填 0 表示不限制
AI_DAILY_GLOBAL_CALLS=
AI_DAILY_VISITOR_CALLS=

# 数据清理：超过 N 天未访问的访客数据会被删除（默认 7 天）。
# 默认只在生产环境运行；VISITOR_CLEANUP=on 可在本地开启，=off 可关闭
VISITOR_RETENTION_DAYS=7
VISITOR_CLEANUP=

# 内部评估页 /internal：本地默认开启；生产环境需同时设置下面两项，访问时带上 ?key=<INTERNAL_EVAL_KEY>
INTERNAL_EVAL_ENABLED=false
INTERNAL_EVAL_KEY=
# 内部评估页的费用估算（元 / 百万 token，可不填，不填只显示 token 数）
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=
